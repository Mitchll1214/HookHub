# 统一行尾：所有文本文件使用 LF，避免 Windows/Unix 混用产生 diff 噪音
* text=auto eol=lf

# 源码文件（JavaScript）
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.ts text eol=lf

# 配置文件
*.toml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.gitignore text eol=lf
*.editorconfig text eol=lf

# 图片与二进制（不做行尾转换）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.zip binary

# Windows 可执行脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf