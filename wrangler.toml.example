# HookHub — Cloudflare Pages 项目配置
name = "hookhub"
compatibility_date = "2024-11-01"
pages_build_output_dir = "public"

# ============================================================
# 用途：本地 CLI 部署/开发模板（复制为 wrangler.toml 使用）
#
# ⚠️ 线上部署请勿提交 wrangler.toml：
#   Cloudflare Pages 检测到仓库根目录存在 wrangler.toml 时，
#   会把绑定（KV）与环境变量的管理权从控制台切到该文件，
#   导致控制台无法编辑、重新部署后配置像被清空。
#   因此本仓库 .gitignore 已忽略 wrangler.toml，
#   线上绑定与环境变量一律在 Pages 控制台配置。
#
# 本地使用步骤：
#   cp wrangler.toml.example wrangler.toml
#   编辑下方 KV id 填入真实命名空间 ID
#   npx wrangler pages dev public --kv=KV_CONFIG
#   npx wrangler pages deploy public --project-name hookhub
#
# 本地 CLI 部署时用下面的配置：
# [[kv_namespaces]]
# binding = "KV_CONFIG"
# id = "换成真实生产环境命名空间 ID"
# preview_id = "换成真实预览环境命名空间 ID"
# ============================================================

# ================= 环境变量（Secret，在 Pages 控制台配置）=================
# 不要把这些写进 wrangler.toml！在 Pages 项目 Settings → Environment variables 里以加密方式添加：
#   ADMIN_PASSWORD  管理员密码（必填，缺失时所有 /api/* 管理接口都会拒绝访问）
#   SIGN_SECRET     HMAC 签名密钥（可选，用于启用 /hook/:token 的 X-Signature 校验）